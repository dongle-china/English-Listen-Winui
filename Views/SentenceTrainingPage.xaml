<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="English_Listen_WinUI.Views.SentenceTrainingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:English_Listen_WinUI.Views"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="TitleText"
                       FontSize="28" FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="IndexText"
                       FontSize="16"
                       Margin="12,10,0,0"
                       VerticalAlignment="Top"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Playback controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,16">
            <Button x:Name="PlayPauseButton"
                    Content="播放"
                    MinWidth="90"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="PlayPauseButton_Click" />
            <Button Content="重听"
                    Click="ReplayButton_Click" />
            <ToggleSwitch x:Name="LoopSwitch"
                          Header="循环"
                          OnContent="开" OffContent="关"
                          Toggled="LoopSwitch_Toggled" />
            <Button Content="上一句"
                    Click="PrevButton_Click" />
            <Button Content="下一句"
                    Click="NextButton_Click" />
        </StackPanel>

        <!-- Word-by-word input -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="WordsPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SentenceWordItem">
                        <StackPanel Margin="4,4,4,10">
                            <TextBox Text="{x:Bind Input, Mode=TwoWay}"
                                     IsReadOnly="{x:Bind Locked}"
                                     MinWidth="90" MaxWidth="220"
                                     PlaceholderText="{x:Bind Placeholder}" />
                            <TextBlock Text="{x:Bind Feedback}"
                                       Foreground="{x:Bind FeedbackBrush}"
                                       FontSize="12"
                                       Visibility="{x:Bind FeedbackVisibility}"
                                       Margin="2,2,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Submit & result -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="SubmitButton"
                    Content="提交校验"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SubmitButton_Click" />
            <TextBlock x:Name="ResultText" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="TranscriptTextBlock"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
