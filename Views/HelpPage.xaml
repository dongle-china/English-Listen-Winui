<Page
    x:Class="English_Listen_WinUI.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="900">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,16" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="帮助" FontSize="36" FontWeight="Bold" Margin="0,0,0,12" />

            <!-- 快速开始 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="快速开始（单词听写）" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="1. 进入「查看单词」页面，添加单词或从文件导入词库&#x0a;2. 勾选要听写的单词，点击「开始听写」&#x0a;3. 选择在线模式（边听边输入）或纸笔模式（纸上作答）&#x0a;4. 完成后查看答案、成绩与统计" />
                </StackPanel>
            </Border>

            <!-- 素材库与转写 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="素材库：导入与转写" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                                Text="1. 进入「素材库」页面，点击导入，选择本地音频或视频文件&#x0a;2. 首次使用需在「设置」页面下载 Whisper 转写模型（从魔搭社区 ModelScope 下载，推荐 base），或指定本地 ggml 模型文件&#x0a;3. 转写在本地完成（Whisper.net），自动切分为句子&#x0a;4. 转写完成后即可对该素材开始句子精听&#x0a;&#x0a;只导入你有权使用的材料；转写与播放全程离线，不上传任何内容。" />
                </StackPanel>
            </Border>

            <!-- 句子精听 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="句子精听：三阶段训练" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="• 泛听：整段连续播放，不要求逐词输入，可标记难点句&#x0a;• 精听：逐句播放，逐词输入校验，可开启原文对照&#x0a;• 复习：只练未掌握的句子，连续全对达到阈值即判定掌握&#x0a;&#x0a;训练中的错误会被归因（拼写、连读、语速等），系统据此自适应调整难度并推荐句子。" />
                </StackPanel>
            </Border>

            <!-- 背单词 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="背单词" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="• 勾选要背诵的单词，设置每日数量与随机顺序&#x0a;• 点击开始背诵，自动朗读单词和中文翻译&#x0a;• 左右箭头切换单词，朗读过的自动标记为已学&#x0a;• 学习记录自动保存，下次背诵自动过滤已学单词" />
                </StackPanel>
            </Border>

            <!-- 单词管理与翻译 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="单词管理与翻译" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="• 词库管理：创建、加载、导入、导出、删除词库，支持分组&#x0a;• 单词列表：搜索、按首字母/数字/特殊字符筛选，批量删除&#x0a;• 批量翻译：调用百度翻译 API 翻译未翻译的单词（需在设置中配置）&#x0a;• 追加到词库：一键把当前单词追加到其他词库" />
                </StackPanel>
            </Border>

            <!-- 快捷键 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="快捷键（听写测试中）" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="• 空格键：重复朗读当前单词&#x0a;• 左方向键：返回上一个单词&#x0a;• 右方向键：跳到下一个单词&#x0a;• ESC 键：暂停 / 继续测试" />
                </StackPanel>
            </Border>

            <!-- 账户与云同步 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="账户与云同步" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="• 支持多用户，每个用户的学习数据相互独立，保存在本地&#x0a;• 个人中心支持登录与云同步（Web API），可在多设备间同步学习记录&#x0a;• 学习历史页面按用户记录听写与精听结果，支持按时间 / 正确率排序" />
                </StackPanel>
            </Border>

            <!-- 设置 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                                Text="• 语音设置：选择语音引擎（Windows SAPI / TTS），支持试听&#x0a;• 翻译 API：配置百度翻译参数&#x0a;• Whisper 模型：从魔搭社区下载（显示速度、大小与剩余时间），或选择本地 ggml 模型&#x0a;• 随机播放、朗读间隔（1–60 秒）、每日单词量等训练选项&#x0a;• 初始化程序：清除所有本地数据并重置" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
