<Page
    x:Class="English_Listen_WinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:English_Listen_WinUI.Views"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="900">

    <Page.Resources>
        <!-- 左侧暗色渐变，保证插画上的白色标题可读（浅色/深色主题共用） -->
        <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#CC000000" />
            <GradientStop Offset="0.55" Color="#66000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>

        <!-- 复刻 WinUI Gallery ControlItemTemplate（32px 图标 + 标题底部对齐 + Caption 副标题）；
             Gallery 用 GridView ItemClick 处理交互，这里用 Button 包装获得等价悬停/按压反馈 -->
        <DataTemplate x:Key="CardTemplate" x:DataType="local:HomeCardItem">
            <Button Tag="{x:Bind PageName}"
                    Click="Card_Click"
                    AutomationProperties.Name="{x:Bind Title}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="96"
                    Padding="8"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <SymbolIcon Grid.RowSpan="2"
                                Width="32"
                                Margin="8,12,16,0"
                                VerticalAlignment="Top"
                                Symbol="{x:Bind Glyph}" />
                    <TextBlock Grid.Column="1"
                               Margin="0,12,0,0"
                               VerticalAlignment="Bottom"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind Title}"
                               TextLineBounds="TrimToCapHeight"
                               TextWrapping="NoWrap" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{x:Bind Subtitle}"
                               TextTrimming="WordEllipsis"
                               ToolTipService.ToolTip="{x:Bind Subtitle}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 复刻 WinUI Gallery Controls/HomePage/Tile.xaml：固定 232×172、亚克力底、圆角 8、
             图标区顶部（高 36）、标题+描述贴底部、外链瓦片右下角小箭头（E8A7） -->
        <DataTemplate x:Key="LinkTileTemplate" x:DataType="local:LinkTileItem">
            <Button Width="232"
                    Height="172"
                    Click="Tile_Click"
                    AutomationProperties.Name="{x:Bind Title}"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    CornerRadius="8"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1">
                <Grid Padding="24"
                      VerticalAlignment="Stretch"
                      RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <FontIcon Grid.RowSpan="3"
                              Margin="-12"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              FontSize="14"
                              Glyph="&#xE8A7;"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Visibility="{x:Bind ArrowVisibility}" />
                    <Grid Height="36">
                        <SymbolIcon Symbol="{x:Bind Glyph}"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Visibility="{x:Bind SymbolVisibility}" />
                        <Image Source="{x:Bind Icon}"
                               Width="36"
                               Height="36"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Visibility="{x:Bind IconVisibility}" />
                    </Grid>
                    <StackPanel Grid.Row="1"
                                Spacing="4"
                                VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind Title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="NoWrap" />
                        <TextBlock Text="{x:Bind Description}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,16" Spacing="20">

            <!-- 头部插画（浅色/深色主题由代码后置切换 ActualThemeChanged） -->
            <Grid Height="220" CornerRadius="8">
                <Image x:Name="HeroImage" Stretch="UniformToFill" />
                <Rectangle Fill="{StaticResource HeroScrimBrush}" />
                <StackPanel Margin="28,0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="English Listen" FontSize="36" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="智能英语精听训练台 · 听写 · 背诵 · 逐句精听"
                               FontSize="14" Foreground="#E5FFFFFF" />
                </StackPanel>
            </Grid>

            <!-- 学习统计 -->
            <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Spacing="12"
                        Visibility="Collapsed">
                <InfoBar x:Name="TotalTestsInfoBar" Title="总测试次数: 0" Severity="Informational"
                         IsClosable="False" IsOpen="True" />
                <InfoBar x:Name="AvgAccuracyInfoBar" Title="平均正确率: 0%" Severity="Success"
                         IsClosable="False" IsOpen="True" />
            </StackPanel>

            <!-- 快速开始（Gallery Tile 风格瓦片：应用内导航 + 本软件 GitHub 外链） -->
            <StackPanel Spacing="12">
                <TextBlock Text="快速开始" FontSize="20" FontWeight="SemiBold" />
                <ItemsRepeater x:Name="LinksRepeater" ItemTemplate="{StaticResource LinkTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="232" MinItemHeight="172"
                                           MinRowSpacing="12" MinColumnSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!-- 学习资源（词典 / 听力 / 阅读 / 工具，应用内 WebView2 窗口打开） -->
            <StackPanel Spacing="12">
                <TextBlock Text="学习资源" FontSize="20" FontWeight="SemiBold" />
                <ItemsRepeater x:Name="ResourcesRepeater" ItemTemplate="{StaticResource LinkTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="232" MinItemHeight="172"
                                           MinRowSpacing="12" MinColumnSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!-- 功能导航 -->
            <StackPanel Spacing="12">
                <TextBlock Text="功能导航" FontSize="20" FontWeight="SemiBold" />
                <ItemsRepeater x:Name="CardsRepeater" ItemTemplate="{StaticResource CardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="300" MinItemHeight="96"
                                           MinRowSpacing="12" MinColumnSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!-- 版本页脚（来自 Package.appxmanifest） -->
            <TextBlock x:Name="VersionTextBlock" FontSize="12" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
