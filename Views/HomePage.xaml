<Page
    x:Class="English_Listen_WinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:English_Listen_WinUI.Views"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="900">

    <Page.Resources>
        <!-- 左侧暗色渐变，保证插画上的白色标题可读（浅色/深色主题共用） -->
        <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#CC000000" />
            <GradientStop Offset="0.55" Color="#66000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>

        <!-- WinUI Gallery 风格的功能卡片 -->
        <DataTemplate x:Key="CardTemplate" x:DataType="local:HomeCardItem">
            <Button Tag="{x:Bind PageName}"
                    Click="Card_Click"
                    AutomationProperties.Name="{x:Bind Title}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MinHeight="96"
                    Padding="16"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="40" Height="40"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Top">
                        <SymbolIcon Symbol="{x:Bind Glyph}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center" MaxWidth="220">
                        <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,16" Spacing="20">

            <!-- 头部插画（浅色/深色主题由代码后置切换 ActualThemeChanged） -->
            <Grid Height="220" CornerRadius="8">
                <Image x:Name="HeroImage" Stretch="UniformToFill" />
                <Rectangle Fill="{StaticResource HeroScrimBrush}" />
                <StackPanel Margin="28,0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="English Listen" FontSize="36" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="智能英语精听训练台 · 听写 · 背诵 · 逐句精听"
                               FontSize="14" Foreground="#E5FFFFFF" />
                </StackPanel>
            </Grid>

            <!-- 学习统计 -->
            <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Spacing="12"
                        Visibility="Collapsed">
                <InfoBar x:Name="TotalTestsInfoBar" Title="总测试次数: 0" Severity="Informational"
                         IsClosable="False" IsOpen="True" />
                <InfoBar x:Name="AvgAccuracyInfoBar" Title="平均正确率: 0%" Severity="Success"
                         IsClosable="False" IsOpen="True" />
            </StackPanel>

            <!-- 功能导航 -->
            <StackPanel Spacing="12">
                <TextBlock Text="功能导航" FontSize="20" FontWeight="SemiBold" />
                <ItemsRepeater x:Name="CardsRepeater" ItemTemplate="{StaticResource CardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="230" MinItemHeight="96"
                                           MinRowSpacing="12" MinColumnSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!-- 版本页脚（来自 Package.appxmanifest） -->
            <TextBlock x:Name="VersionTextBlock" FontSize="12" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
