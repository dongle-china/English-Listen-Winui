<Page
    x:Class="English_Listen_WinUI.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,40" MaxWidth="800" HorizontalAlignment="Center" Spacing="20">

            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <FontIcon Glyph="&#xE77B;" FontSize="28" Margin="0,0,12,0"
                          Foreground="{ThemeResource SystemAccentColor}" />
                <TextBlock Text="个人中心" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 资料头卡片：头像 + 昵称 + 元信息 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="24" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border x:Name="AvatarBorder" Width="64" Height="64" CornerRadius="32"
                                Background="{ThemeResource SystemAccentColor}">
                            <TextBlock x:Name="AvatarInitialText" Text="?" FontSize="28"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="NicknameText" Text="未登录" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="MetaText" Text="离线模式，数据保存在本地"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock x:Name="EmailText" Text="" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondary}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="LoginPromptPanel" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="GoLoginButton" Click="GoLoginButton_Click"
                                Background="{ThemeResource SystemAccentColor}" Foreground="White"
                                CornerRadius="6" Padding="16,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="White" />
                                <TextBlock Text="登录 / 注册" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="登录后可同步云端数据、编辑资料与修改密码"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondary}" />
                    </StackPanel>
                    <Button x:Name="LogoutButton" Click="LogoutButton_Click"
                            Visibility="Collapsed" Padding="16,6" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                            <TextBlock Text="退出登录" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 编辑资料（对齐 web：昵称 2-24 字，头像 http(s) 链接） -->
            <Border x:Name="EditProfileCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="24" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE70F;" FontSize="20" Margin="0,0,8,0"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock Text="编辑资料" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBox x:Name="NicknameBox" Header="昵称" PlaceholderText="2-24 个字符" MaxLength="24" />
                    <TextBox x:Name="AvatarUrlBox" Header="头像链接"
                             PlaceholderText="https://...（留空使用首字母头像）" />
                    <Button Content="保存资料" Click="SaveProfileButton_Click"
                            Background="{ThemeResource SystemAccentColor}" Foreground="White"
                            CornerRadius="6" Padding="16,6" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 修改密码（对齐 web：验证当前密码，新密码至少 8 位） -->
            <Border x:Name="ChangePasswordCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="24" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE72E;" FontSize="20" Margin="0,0,8,0"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock Text="修改密码" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <PasswordBox x:Name="CurrentPasswordBox" Header="当前密码" />
                    <PasswordBox x:Name="NewPasswordBox" Header="新密码" PlaceholderText="至少 8 位" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Header="确认新密码" />
                    <Button Content="修改密码" Click="ChangePasswordButton_Click"
                            CornerRadius="6" Padding="16,6" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 成绩分析（统计卡片 + 正确率趋势，替代 web 端的收藏/历史） -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="24" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE9D2;" FontSize="20" Margin="0,0,8,0"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock Text="成绩分析" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="10" CornerRadius="8">
                            <TextBlock Text="总测试次数" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TotalTestsText" Text="0" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="10" CornerRadius="8">
                            <TextBlock Text="平均正确率" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
                            <TextBlock x:Name="AvgAccuracyText" Text="0%" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="10" CornerRadius="8">
                            <TextBlock Text="总学习单词" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TotalWordsText" Text="0" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="10" CornerRadius="8">
                            <TextBlock Text="连续学习天数" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
                            <TextBlock x:Name="StreakDaysText" Text="0" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="正确率趋势" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <Canvas x:Name="AccuracyChartCanvas" Height="200" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- 句子训练统计（三阶段进度 + 卡点词，数据来自 training_sessions.json 与句子训练历史记录） -->
            <Border x:Name="SentenceStatsCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Padding="24" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE8AC;" FontSize="20" Margin="0,0,8,0"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock Text="句子训练" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="10" CornerRadius="8">
                            <TextBlock Text="训练素材" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SentenceSourceCountText" Text="0" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="10" CornerRadius="8">
                            <TextBlock Text="句子掌握" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SentenceMasteryText" Text="-" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="10" CornerRadius="8">
                            <TextBlock Text="精听进度" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
                            <TextBlock x:Name="IntensiveProgressText" Text="-" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="10" CornerRadius="8">
                            <TextBlock Text="提示使用" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SentenceHintCountText" Text="0" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ExtensiveProgressSummaryText" Text="泛听完成度 0%"
                               FontSize="13" />
                    <ProgressBar x:Name="ExtensiveProgressSummaryBar" Minimum="0" Maximum="100" />

                    <TextBlock Text="卡点 Top 词" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TopWordsText" Text="暂无错误记录" FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
