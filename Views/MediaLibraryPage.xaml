<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="English_Listen_WinUI.Views.MediaLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:English_Listen_WinUI.Views"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="素材库"
                   FontSize="36" FontWeight="Bold"
                   Margin="0,0,0,16" />

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Button x:Name="ImportButton"
                    Content="导入音视频"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ImportButton_Click" />
            <Button x:Name="ModelButton"
                    Content="选择转写模型"
                    Click="ModelButton_Click" />
            <TextBlock x:Name="ModelStatusText"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Status / progress -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <InfoBar x:Name="ModelInfoBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Warning"
                     Title="未配置转写模型"
                      Message="转写需要 Whisper ggml 模型文件。可在「设置」页面从魔搭社区下载（推荐 base 模型），或点击上方&#x201C;选择转写模型&#x201D;指定本地文件。" />
            <InfoBar x:Name="ErrorInfoBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Error" />
            <ProgressBar x:Name="ImportProgress"
                         Visibility="Collapsed"
                         IsIndeterminate="True"
                         Margin="0,8,0,0" />
            <TextBlock x:Name="ImportStatusText"
                       Visibility="Collapsed"
                       Margin="0,4,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Material list -->
        <ListView Grid.Row="3"
                  x:Name="MaterialList"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MaterialItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Subtitle}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{x:Bind StatusText}"
                                       Foreground="{x:Bind StatusBrush}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Spacing="8"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Right">
                                <Button Content="开始精听"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind CanTrain}"
                                        Click="TrainButton_Click" />
                                <Button Content="重新转写"
                                        Visibility="{x:Bind RetryVisibility}"
                                        Click="RetryButton_Click" />
                                <Button Content="删除"
                                        Click="DeleteButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <TextBlock Grid.Row="3"
                   x:Name="EmptyText"
                   Text="暂无素材。点击&#x201C;导入音视频&#x201D;添加本地 mp3 / mp4 / wav 等文件，导入后自动转写切句。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</Page>
