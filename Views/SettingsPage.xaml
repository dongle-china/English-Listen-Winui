<Page
    x:Class="English_Listen_WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:English_Listen_WinUI.Views"
    mc:Ignorable="d"
    d:DesignHeight="400" d:DesignWidth="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="设置"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" Margin="20" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="20">
            <StackPanel Spacing="15">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="主题设置"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,10" />
                        <ComboBox x:Name="ThemeComboBox" Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="0" />
                            <ComboBoxItem Content="浅色" Tag="1" />
                            <ComboBoxItem Content="深色" Tag="2" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="朗读设置"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,15" />

                        <StackPanel Margin="0,10">
                            <TextBlock Text="朗读时间间隔(秒):"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,5" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                                <Slider x:Name="IntervalSlider" Grid.Column="0" Grid.Row="0"
                                        Minimum="1" Maximum="30" Value="5"
                                        ValueChanged="IntervalSlider_ValueChanged" />
                                <TextBlock x:Name="IntervalText" Grid.Column="1" Grid.Row="0"
                                           Text="5秒"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Style="{ThemeResource BodyTextBlockStyle}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,15,0,10">
                            <TextBlock Text="语音引擎:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,5" />
                            <ComboBox x:Name="EngineComboBox"
                                      SelectionChanged="EngineComboBox_SelectionChanged">
                                <ComboBoxItem Content="SAPI" Tag="SAPI" />
                                <ComboBoxItem Content="自然语音" Tag="Natural" />
                                <ComboBoxItem Content="WinRT TTS" Tag="WinRT" />
                            </ComboBox>
                            <TextBlock x:Name="EngineStatusText" Text=""
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondary}"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <!-- Windows TTS 语音选择 -->
                        <StackPanel Margin="0,15,0,10" x:Name="WindowsTtsVoicePanel" Visibility="Collapsed">
                            <TextBlock Text="英文语音:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,5" />
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox x:Name="WindowsTtsEnglishVoiceComboBox" Grid.Column="0"
                                          SelectionChanged="WindowsTtsEnglishVoiceComboBox_SelectionChanged" />
                                <Button x:Name="WindowsTtsEnglishPreviewButton" Grid.Column="1"
                                        Content="试听" Margin="10,0,0,0" Width="60"
                                        Click="WindowsTtsEnglishPreviewButton_Click" />
                            </Grid>
                        </StackPanel>

                        <!-- Windows TTS 中文语音选择 -->
                        <StackPanel Margin="0,15,0,10" x:Name="WindowsTtsChineseVoicePanel" Visibility="Collapsed">
                            <TextBlock Text="中文语音:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,5" />
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox x:Name="WindowsTtsChineseVoiceComboBox" Grid.Column="0"
                                          SelectionChanged="WindowsTtsChineseVoiceComboBox_SelectionChanged" />
                                <Button x:Name="WindowsTtsChinesePreviewButton" Grid.Column="1"
                                        Content="试听" Margin="10,0,0,0" Width="60"
                                        Click="WindowsTtsChinesePreviewButton_Click" />
                            </Grid>
                        </StackPanel>


                        <!-- WinRT TTS 用 MediaPlayerElement 播放，隐藏播放控制 -->
                        <MediaPlayerElement x:Name="TtsMediaPlayerElement" Height="0"
                                            AreTransportControlsEnabled="False" />

                        <CheckBox x:Name="RandomOrderCheckBox" Content="随机播放单词"
                                  Checked="RandomOrderCheckBox_Changed"
                                  Unchecked="RandomOrderCheckBox_Changed"
                                  Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="模型管理"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,5" />
                        <TextBlock Text="Whisper 转写模型（用于素材库本地离线转写），从魔搭社区 (ModelScope) 下载；也可在素材库页改选其他本地模型文件。"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <ListView x:Name="ModelList" SelectionMode="None" Margin="0,10,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ModelListItem">
                                    <Grid ColumnDefinitions="80,*,70,Auto" ColumnSpacing="12" Padding="0,10">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Description}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                            <Button Content="{x:Bind DownloadAction}"
                                                    IsEnabled="{x:Bind DownloadEnabled}"
                                                    Tag="{x:Bind FileName}"
                                                    Click="ModelDownload_Click" MinWidth="72" />
                                            <Button Content="删除"
                                                    Visibility="{x:Bind DeleteVisibility}"
                                                    Tag="{x:Bind FileName}"
                                                    Click="ModelDelete_Click" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ProgressBar x:Name="ModelDownloadProgress"
                                     Visibility="Collapsed"
                                     Margin="0,12,0,0" />
                        <TextBlock x:Name="ModelDownloadStatusText"
                                   Visibility="Collapsed"
                                   Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <HyperlinkButton x:Name="OpenModelsFolderButton"
                                         Content="打开模型目录"
                                         Click="OpenModelsFolderButton_Click"
                                         Margin="0,10,0,0" Padding="0" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <TextBlock Text="当前使用模型:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="ActiveModelComboBox" MinWidth="280"
                                      SelectionChanged="ActiveModelComboBox_SelectionChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="百度翻译API设置"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,15" />

                        <StackPanel Margin="0,10">
                            <TextBlock Text="API模式:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,5" />
                            <ComboBox x:Name="TranslateApiModeComboBox" Width="200"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="TranslateApiModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="默认API" Tag="default" />
                                <ComboBoxItem Content="自定义API" Tag="custom" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,15,0,10" x:Name="CustomApiPanel" Visibility="Collapsed">
                            <TextBlock Text="App ID:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,5" />
                            <TextBox x:Name="AppIdTextBox" Width="300"
                                     PlaceholderText="请输入百度翻译App ID"
                                     TextChanged="CustomApiTextBox_TextChanged" />

                            <TextBlock Text="密钥:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,15,0,5" />
                            <PasswordBox x:Name="SecretKeyBox" Width="300"
                                         PlaceholderText="请输入百度翻译密钥"
                                         PasswordChanged="CustomApiTextBox_TextChanged" />

                            <Button x:Name="ConfirmCustomApiButton" Content="确认"
                                    Width="100" Margin="0,15,0,0"
                                    Click="ConfirmCustomApiButton_Click" />
                        </StackPanel>

                        <StackPanel Margin="0,15,0,10">
                            <TextBlock Text="剩余翻译限额:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,5" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="TranslationLimitText" Text="--"
                                           Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                                <Button x:Name="ClaimLimitButton" Grid.Column="1"
                                        Content="领取限额" Margin="10,0,0,0" Width="100"
                                        Click="ClaimLimitButton_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,15,0,10">
                            <TextBlock Text="获取API Key:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,5" />
                            <HyperlinkButton Content="前往百度翻译开放平台"
                                             NavigateUri="https://fanyi-api.baidu.com/"
                                             Click="HyperlinkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="系统设置"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,15" />

                        <Button Content="初始化程序" Click="InitializeButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left" />
                        <TextBlock x:Name="VersionLabel" Text="当前版本"
                                   Style="{ThemeResource BodyTextBlockStyle}" Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>