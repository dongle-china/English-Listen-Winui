<Page
    x:Class="English_Listen_WinUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="900">

    <Page.Resources>
        <x:Double x:Key="CardSpacing">12</x:Double>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,16" Spacing="{StaticResource CardSpacing}" MaxWidth="720"
                    HorizontalAlignment="Left">

            <TextBlock Text="关于" FontSize="36" FontWeight="Bold" Margin="0,0,0,12" />

            <!-- 版本信息 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="版本信息" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionTextBlock" FontSize="14" />
                    <TextBlock Text="English Listen · 智能英语精听训练台"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 软件介绍 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="软件介绍" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock FontSize="14" TextWrapping="Wrap"
                               Text="English Listen 是一款离线优先的英语精听训练工具，基于 WinUI 3 开发。从单词听写起步，覆盖词库管理、背诵、真实音视频素材导入、Whisper 本地转写切句、泛听/精听/复习三阶段句子训练，并基于你的错误模式提供自适应难度与内容推荐。" />
                </StackPanel>
            </Border>

            <!-- 核心功能 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="核心功能" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock FontSize="14" TextWrapping="Wrap"
                               Text="• 词库管理与单词听写（在线 / 纸笔模式，随机顺序、朗读翻译）&#x0a;• 背单词（每日计划、自动朗读、学习记录）&#x0a;• 素材库（导入本地音视频，Whisper.net 本地转写自动切句）&#x0a;• 句子精听（泛听 → 精听 → 复习三阶段训练）&#x0a;• 自适应难度规则引擎与句子推荐（纯本地、可解释）&#x0a;• 错误标签体系（语音识别、拼写、连读等错误归因）&#x0a;• 学习历史与统计图表，支持导出&#x0a;• 百度翻译集成与批量翻译&#x0a;• 多用户管理、云同步（Web API）&#x0a;• 深色 / 浅色主题，微软雅黑界面字体" />
                </StackPanel>
            </Border>

            <!-- 开源与许可 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="开源与许可" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="本项目基于 MIT 许可证开源，欢迎 Star、Fork 与贡献。"
                               FontSize="14" TextWrapping="Wrap" />
                    <HyperlinkButton Content="GitHub 仓库"
                                     NavigateUri="https://github.com/dongle-china/English-Listen-Winui"
                                     FontSize="14" />
                    <TextBlock Text="版权所有 © 2026 dongle"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
