<Page
    x:Class="English_Listen_WinUI.Views.CloudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="800">

    <Page.Resources>
        <LinearGradientBrush x:Key="LoginGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4A90E2" Offset="0.0" />
            <GradientStop Color="#FF7B68EE" Offset="0.5" />
            <GradientStop Color="#FF9013FE" Offset="1.0" />
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" MaxWidth="420" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Padding="0,40,0,0">

                <!-- App Icon + Title -->
                <FontIcon Glyph="&#xE82C;" FontSize="56"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource LoginGradient}"
                          Margin="0,0,0,10"/>
                <TextBlock Text="English Listen"
                           FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource LoginGradient}"/>
                <TextBlock Text="英语听写训练系统"
                           FontSize="14" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondary}"
                           Margin="0,0,0,30"/>

                <!-- Login Card -->
                <Border x:Name="LoginCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="28" Margin="0,0,0,20"
                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="StatusText" Text="登录"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"/>

                        <!-- Login Form -->
                        <StackPanel x:Name="LoginPanel" Spacing="14">
                            <TextBox x:Name="EmailBox" Header="邮箱"
                                     PlaceholderText="your@email.com"/>
                            <PasswordBox x:Name="PasswordBox" Header="密码"
                                         PlaceholderText="请输入密码"/>
                            <Button x:Name="LoginBtn" Content="登 录" Click="LoginBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Height="40"
                                    CornerRadius="8" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Logged In Info -->
                        <StackPanel x:Name="LoggedInPanel" Visibility="Collapsed" Spacing="12">
                            <FontIcon Glyph="&#xE77B;" FontSize="48"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource SystemAccentColor}"
                                      Margin="0,10,0,0"/>
                            <TextBlock x:Name="UserEmailText" Text=""
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="UserRoleText" Text=""
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondary}"/>

                            <Button Content="退出登录" Click="LogoutBtn_Click"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Register Link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5"
                            x:Name="RegisterLink">
                    <TextBlock Text="没有账号？" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondary}"/>
                    <HyperlinkButton Content="注册新账号" Click="GoToRegister_Click"
                                     FontSize="13"/>
                </StackPanel>

                <!-- Cloud Sync -->
                <StackPanel x:Name="CloudSyncPanel" Visibility="Collapsed" Spacing="12" Margin="0,20,0,0">
                    <TextBlock Text="☁ 云同步" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>

                    <Button x:Name="CloudSyncAllBtn" Content="全部同步" Click="CloudSyncAllBtn_Click"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40" CornerRadius="8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CloudUploadStudyBtn" Grid.Column="0" Content="上传学习进度" Click="CloudUploadStudyBtn_Click" Height="36" Margin="0,0,5,0"/>
                        <Button x:Name="CloudDownloadStudyBtn" Grid.Column="1" Content="下载学习进度" Click="CloudDownloadStudyBtn_Click" Height="36" Margin="5,0,0,0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CloudUploadGroupsBtn" Grid.Column="0" Content="上传分组" Click="CloudUploadGroupsBtn_Click" Height="36" Margin="0,0,5,0"/>
                        <Button x:Name="CloudDownloadGroupsBtn" Grid.Column="1" Content="下载分组" Click="CloudDownloadGroupsBtn_Click" Height="36" Margin="5,0,0,0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CloudUploadTransBtn" Grid.Column="0" Content="上传翻译库" Click="CloudUploadTransBtn_Click" Height="36" Margin="0,0,5,0"/>
                        <Button x:Name="CloudDownloadTransBtn" Grid.Column="1" Content="下载翻译库" Click="CloudDownloadTransBtn_Click" Height="36" Margin="5,0,0,0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CloudUploadWordsBtn" Grid.Column="0" Content="上传词库" Click="CloudUploadWordsBtn_Click" Height="36" Margin="0,0,5,0"/>
                        <Button x:Name="CloudDownloadWordsBtn" Grid.Column="1" Content="下载词库" Click="CloudDownloadWordsBtn_Click" Height="36" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
