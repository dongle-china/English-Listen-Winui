<Page
    x:Class="English_Listen_WinUI.Views.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="学习历史" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="20" />
        </StackPanel>

        <!-- History List -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                <TextBlock Text="记录" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <ComboBox x:Name="SortComboBox" SelectedIndex="0" Margin="20,0,0,0" MinWidth="120"
                          SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Tag="Newest">最新优先</ComboBoxItem>
                    <ComboBoxItem Tag="Oldest">最早优先</ComboBoxItem>
                    <ComboBoxItem Tag="Accuracy">正确率优先</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <ListView x:Name="HistoryListView" Grid.Row="1" Margin="10">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="15" Margin="5" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding WordListName}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding TimestampFormatted}" FontSize="12" Foreground="Gray" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CorrectCount}" FontSize="20" FontWeight="Bold"
                                               Foreground="{ThemeResource SystemAccentColor}" />
                                    <TextBlock Text="/" FontSize="20" VerticalAlignment="Center" Margin="5,0" />
                                    <TextBlock Text="{Binding TotalWords}" FontSize="20" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding AccuracyFormatted}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{ThemeResource SystemAccentColor}"
                                           VerticalAlignment="Center" Margin="20,0,0,0"
                                           Visibility="{Binding AccuracyVisibility}" />

                                <Button Grid.Column="3" Content="再次听写"
                                        Visibility="{Binding RedictateVisibility}"
                                        Click="RedictateButton_Click"
                                        Margin="20,0,0,0" Padding="12,6"
                                        VerticalAlignment="Center" />

                                <Button Grid.Column="4" Content="再次学习"
                                        Visibility="{Binding RelearnVisibility}"
                                        Click="RelearnButton_Click"
                                        Margin="20,0,0,0" Padding="12,6"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="导出记录" Click="ExportButton_Click" Width="120" Height="40" Margin="10" />
            <Button Content="清空记录" Click="ClearButton_Click" Width="120" Height="40" Margin="10" />
        </StackPanel>
    </Grid>
</Page>
